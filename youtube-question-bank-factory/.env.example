# Copy this file to .env and fill in only what you actually use.
# NOTHING in this file is required for local TTS (Kokoro/Piper) to work.
# API keys are only needed if AI_PROVIDER in config.yaml is set to
# "claude", "openai", or "gemini". The default AI_PROVIDER "local"
# needs none of these and runs fully offline.

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=

# --- OpenAI ---
OPENAI_API_KEY=

# --- Gemini (Google) ---
GOOGLE_API_KEY=

# --- Overrides (optional, take precedence over config.yaml) ---
# AI_PROVIDER=local
# TTS_PROVIDER=kokoro
# TTS_CONCURRENCY=2
